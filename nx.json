{
  "extends": "nx/presets/npm.json",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "noMarkdown": [
      "!{projectRoot}/**/*.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": [
        "noMarkdown",
        "^noMarkdown"
      ],
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "inputs": [
        "noMarkdown",
        "^noMarkdown"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "cdk:deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "source ../../tools/scripts/setup-aws-cdk-env.sh && cdk deploy"
      },
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "cdk:destroy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "source ../../tools/scripts/setup-aws-cdk-env.sh && cdk destroy --force"
      },
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "cdk:diff": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "source ../../tools/scripts/setup-aws-cdk-env.sh && cdk diff"
      },
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "cdk:synth": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "cdk synth"
      },
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "cdk:bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "source ../../tools/scripts/setup-aws-cdk-env.sh && cdk bootstrap aws://$CDK_DEFAULT_ACCOUNT/$CDK_DEFAULT_REGION"
      },
      "dependsOn": [
        "build",
        "^build"
      ]
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "conventionalCommits": {
      "feat": true,
      "fix": {
        "changelog": {
          "hidden": true
        }
      },
      "chore": false,
      "docs": false,
      "style": false,
      "refactor": false,
      "wip": false
    },
    "version": {
      "conventionalCommits": true,
      "generatorOptions": {
        "fallbackCurrentVersionResolver": "latest"
      }
    },
    "changelog": {
      "projectChangelogs": {
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    }
  },
  "defaultBase": "main",
  "defaultProject": "admin-client",
  "plugins": [
    "nx/plugins/package-json"
  ],
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
}